<%# app/views/shared/_notification_bell.html.erb %>
<div class="dropdown dropdown-end" data-controller="notifications">
  <label tabindex="0" class="btn btn-ghost btn-circle relative" data-action="click->notifications#load">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
    <% if current_user.notifications.unread.any? %>
      <span class="badge badge-xs badge-error absolute -top-1 -right-1">
        <%= current_user.notifications.unread.count %>
      </span>
    <% end %>
  </label>

  <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-80 p-2 shadow" data-notifications-target="dropdown">
    <li class="p-2 border-b border-base-300 flex items-center justify-between">
      <span class="font-semibold">Notifikasi</span>
      <%= link_to "Lihat Semua", notifications_path, class: "text-sm link link-hover" %>
    </li>
    <li data-notifications-target="list">
      <% current_user.notifications.unread.limit(5).each do |n| %>
        <a href="<%= polymorphic_path(n.notifiable) %>" class="flex items-start gap-2 p-2 hover:bg-base-200 rounded-lg" data-action="click->notifications#markAsRead" data-notification-id-value="<%= n.id %>">
          <div class="flex-1 min-w-0">
            <p class="text-sm"><strong><%= n.actor.name.presence || n.actor.email_address %></strong> <%= n.action %> <%= link_to truncate(n.notifiable.title, length: 30), n.notifiable, class: "link" %></p>
            <p class="text-xs opacity-60"><%= time_ago_in_words(n.created_at) %> lalu</p>
          </div>
        </a>
      <% end %>
    </li>
  </ul>
</div>