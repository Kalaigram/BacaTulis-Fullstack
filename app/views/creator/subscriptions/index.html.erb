<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Kelola Subscriber</h1>
  <div class="flex items-center gap-4">
    <div class="stat bg-primary/10 rounded-box px-4 py-2">
      <div class="stat-title text-primary">Total Subscriber</div>
      <div class="stat-value text-primary font-bold"><%= @total_subscribers %></div>
    </div>
    <div class="stat bg-success/10 rounded-box px-4 py-2">
      <div class="stat-title text-success">MRR (Bulanan)</div>
      <div class="stat-value text-success font-bold">Rp <%= number_with_delimiter(@mrr) %></div>
    </div>
  </div>
</div>

<% if @subscriptions.any? %>
  <div class="card bg-base-100 shadow-sm">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>Subscriber</th>
            <th>Paket</th>
            <th>Status</th>
            <th>Mulai</th>
            <th>Berakhir</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% @subscriptions.each do |subscription| %>
            <tr>
              <td>
                <div class="flex items-center gap-2">
                  <% if subscription.subscriber.avatar.attached? %>
                    <%= image_tag subscription.subscriber.avatar_variant(32), class: "w-8 h-8 rounded-full" %>
                  <% else %>
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-content font-bold text-sm">
                      <%= subscription.subscriber.email_address.first.upcase %>
                    </div>
                  <% end %>
                  <div>
                    <div class="font-medium"><%= subscription.subscriber.name.presence || subscription.subscriber.email_address %></div>
                    <div class="text-xs opacity-60"><%= subscription.subscriber.email_address %></div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge badge-lg <%= subscription.tier_name == 'Premium' ? 'badge-warning' : 'badge-info' %>">
                  <%= subscription.tier_name %>
                </span>
              </td>
              <td>
                <span class="badge badge-lg <%= subscription.active? ? 'badge-success' : 'badge-error' %>">
                  <%= subscription.status.humanize %>
                </span>
              </td>
              <td><%= l subscription.created_at.to_date, format: :long %></td>
              <td><%= l subscription.current_period_end.to_date, format: :long %></td>
              <td>
                <div class="flex items-center gap-2">
                  <%= link_to subscription_path(subscription), class: "btn btn-ghost btn-xs" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-actions justify-end p-4 border-t border-base-300">
      <%= render "shared/pagination", collection: @subscriptions %>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-sm text-center py-12">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto opacity-30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.77m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
    <h3 class="text-lg font-semibold mb-1">Belum ada subscriber</h3>
    <p class="opacity-70 mb-4">Bagikan tautan langganan Anda untuk mulai mendapatkan dukungan.</p>
    <%= link_to "Salin Tautan Langganan", subscriptions_new_path(creator_id: current_user.id), class: "btn btn-primary" %>
  </div>
<% end %>