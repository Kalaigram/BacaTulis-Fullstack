<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "BacaTulis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="BacaTulis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200">
    <div class="h-1 bg-primary"></div>

    <div class="navbar bg-base-100 border-b border-base-300 shadow-sm">
      <div class="navbar-start">
        <% if user_signed_in? %>
          <label for="sidebar-drawer" class="btn btn-ghost btn-circle lg:hidden" aria-label="Buka menu">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </label>
        <% end %>
        <%= link_to root_path, class: "flex items-center gap-2 px-2" do %>
          <span class="grid h-8 w-8 place-items-center rounded-md bg-primary text-base font-black text-primary-content shadow">R</span>
          <span class="text-xl font-bold text-base-content">BacaTulis</span>
        <% end %>
      </div>

      <div class="navbar-center hidden lg:flex">
        <% if user_signed_in? %>
          <%= link_to "Reading List", bookmarks_path, class: "btn btn-ghost btn-sm" %>
        <% end %>
      </div>

      <div class="navbar-end">
        <% if user_signed_in? %>
          <%= render "shared/notification_bell" %>

          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar_variant(32), class: "w-8 h-8 rounded-full" %>
              <% else %>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-primary-content font-bold">
                  <%= current_user.email_address.first.upcase %>
                </div>
              <% end %>
              <%= current_user.name.presence || current_user.email_address %>
              <span class="badge <%= current_user.role == "admin" ? "badge-primary" : "badge-info" %>"><%= current_user.role %></span>
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-2 shadow">
              <li><%= link_to "Profil", profile_path %></li>
              <% if current_user.admin? %>
                <li><%= link_to "Admin Dashboard", admin_analytics_path %></li>
              <% end %>
              <li><%= button_to "Keluar", session_path, method: :delete %></li>
            </ul>
          </div>
        <% else %>
          <%= link_to "Masuk", new_session_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>

    <% if user_signed_in? %>
      <div class="drawer lg:drawer-open">
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex min-h-screen flex-col">
          <main class="w-full flex-1 px-4 py-8">
            <%= render "shared/flash" %>
            <%= yield %>
          </main>
        </div>

        <div class="drawer-side z-30">
          <label for="sidebar-drawer" aria-label="Tutup menu" class="drawer-overlay"></label>

          <aside class="menu min-h-full w-72 bg-base-100 p-4 text-base-content">
            <ul>
              <li>
                <%= link_to root_path, class: (current_page?(root_path) ? "menu-active" : "") do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 10.286v4.167c0 1.123.879 2.036 1.963 2.036h15.574c1.084 0 1.963-.913 1.963-2.036V10.286m-3-3.814c0-.621.504-1.123 1.125-1.123h9.75c.621 0 1.125.502 1.125 1.123v18.318c0 .621-.504 1.123-1.125 1.123H5.25c-.621 0-1.125-.502-1.125-1.123V6.472z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  Dashboard
                <% end %>
              </li>
              <li>
                <%= link_to posts_path, class: (current_page?(posts_path) && params[:scope].blank? ? "menu-active" : "") do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H6a3.375 3.375 0 00-3.375 3.375v11.25A3.375 3.375 0 006 21.75h12a3.375 3.375 0 003.375-3.375V5.625A3.375 3.375 0 0018 2.25h-7.5z" /></svg>
                  Semua Post
                <% end %>
              </li>
              <li>
                <%= link_to posts_path(scope: "mine"), class: (params[:scope] == "mine" ? "menu-active" : "") do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                  Post Saya
                <% end %>
              </li>
              <li>
                <%= link_to bookmarks_path, class: (current_page?(bookmarks_path) ? "menu-active" : "") do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 2.2-.048 3.213.352a21.682 21.682 0 0110.425 2.353 3.003 3.003 0 01.379 3.838c-.459.678-.958 1.332-1.493 1.997a21.604 21.604 0 01-7.158 9.55c-.398.137-.83.226-1.275.266-.65.057-1.538-.182-2.4-1.157a21.582 21.582 0 01-1.921-2.532m0 0a3.019 3.019 0 00-3.785 0M6.879 18.416c.53-.53 1.01-1.09 1.506-1.629a21.603 21.603 0 017.158-9.55c.459-.678.958-1.332 1.493-1.997a3.004 3.004 0 013.838.379 21.683 21.683 0 0110.426-2.354 3.002 3.002 0 013.213-.352m-10.434 12.614c1.429 1.277 3.37 1.707 5.068.893a21.514 21.514 0 013.62-2.59" /></svg>
                  Reading List
                <% end %>
              </li>
              <% if current_user.admin? %>
                <li>
                  <%= link_to categories_path, class: (current_page?(categories_path) ? "menu-active" : "") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 016 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m-16.5 0a2.25 2.25 0 00-2.25 2.25v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V6.75a9 9 0 00-9-9z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5a9 9 0 0118 0m-9 3.75h.008v.008H12.75a.75.75 0 01-.75-.75v-.75A.75.75 0 0112.75 15h2.25a.75.75 0 00.75-.75V6.75a9 9 0 00-9-9" /></svg>
                    Kategori
                  <% end %>
                </li>
                <li>
                  <%= link_to tags_path, class: (current_page?(tags_path) ? "menu-active" : "") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a2.25 2.25 0 00-3.072-1.57l-1.547 3.606a2.25 2.25 0 01-1.446 1.748l-4.712 2.03" /></svg>
                    Tags
                  <% end %>
                </li>
                <li>
                  <%= link_to users_path, class: (current_page?(users_path) ? "menu-active" : "") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.77m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                    Pengguna
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_reports_path, class: (current_page?(admin_reports_path) ? "menu-active" : "") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
                    Laporan
                  <% end %>
                </li>
                <li>
                  <%= link_to admin_analytics_path, class: (current_page?(admin_analytics_path) ? "menu-active" : "") do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 016 16.5h2.25m-2.25 0a2.25 2.25 0 01-2.25-2.25V3a2.25 2.25 0 012.25-2.25h4.5A2.25 2.25 0 0115 3v2.25a2.25 2.25 0 01-2.25 2.25H9.75M12 8.25h.008v.008H12V8.25zM21 3a2.25 2.25 0 012.25 2.25v2.25a2.25 2.25 0 01-2.25 2.25h-4.5a2.25 2.25 0 01-2.25-2.25V5.25a2.25 2.25 0 012.25-2.25h2.25M18 8.25h.008v.008H18V8.25zM6 18.75a2.25 2.25 0 002.25 2.25h2.25a2.25 2.25 0 002.25-2.25V15a2.25 2.25 0 00-2.25-2.25h-4.5a2.25 2.25 0 00-2.25 2.25v2.25a2.25 2.25 0 002.25 2.25h2.25M12 16.5h.008v.008H12v-.008z" /></svg>
                    Analytics
                  <% end %>
                </li>
              <% end %>
            </ul>
          </aside>
        </div>
      </div>
    <% else %>
      <main class="w-full flex-1 px-4 py-8">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>