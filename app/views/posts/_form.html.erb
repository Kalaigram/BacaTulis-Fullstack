<%= form_with(model: post, html: { multipart: true }) do |form| %>
  <% if post.errors.any? %>
    <div role="alert" class="alert alert-error mb-4">
      <div>
        <h2 class="font-bold">Form tidak valid, ada <%= post.errors.count %> kesalahan:</h2>
        <ul class="list-disc list-inside text-sm mt-1">
          <% post.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <fieldset class="fieldset">
        <label class="fieldset-label">Judul
          <%= form.text_field :title, class: "input w-full" %>
        </label>

        <label class="fieldset-label">Isi
          <%= form.rich_text_area :body, class: "w-full" %>
        </label>

        <label class="fieldset-label">Gambar Utama (Hero Image)
          <%= form.file_field :hero_image, accept: "image/*", class: "file-input file-input-bordered w-full" %>
          <% if post.hero_image.attached? %>
            <div class="mt-2">
              <%= image_tag post.hero_image.variant(resize_to_limit: [300, 200]), class: "rounded-lg" %>
              <label class="label cursor-pointer mt-1">
                <input type="checkbox" name="post[remove_hero_image]" value="1" class="checkbox checkbox-primary">
                <span class="label-text text-error">Hapus gambar ini</span>
              </label>
            </div>
          <% end %>
        </label>

        <label class="fieldset-label">Gambar Tambahan
          <%= form.file_field :images, accept: "image/*", multiple: true, class: "file-input file-input-bordered w-full" %>
          <% if post.images.attached? %>
            <div class="mt-2 grid gap-2 sm:grid-cols-3">
              <% post.images.each do |image| %>
                <div class="relative group">
                  <%= image_tag image.variant(resize_to_limit: [150, 150]), class: "rounded-lg w-full h-24 object-cover" %>
                  <label class="absolute inset-0 bg-black/50 text-white opacity-0 group-hover:opacity-100 flex items-center justify-center cursor-pointer transition-opacity rounded-lg">
                    <input type="checkbox" name="post[remove_image_ids][]" value="<%= image.id %>" class="sr-only peer">
                    <span class="peer-checked:opacity-100">Hapus</span>
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
        </label>

        <label class="fieldset-label">Kategori
          <%= form.select :category_id,
                          options_from_collection_for_select(Category.order(:name), :id, :name, post.category_id),
                          { include_blank: "Tanpa kategori" },
                          class: "select select-bordered w-full" %>
        </label>

        <%= render "tag_form", post: post %>

        <label class="fieldset-label">Status
          <%= form.select :status,
                          options_for_select([ [ "Publikasi", "published" ], [ "Draft", "draft" ] ], post.status),
                          {},
                          class: "select select-bordered w-full" %>
        </label>

        <label class="fieldset-label">Akses Konten
          <%= form.select :paid,
                          options_for_select([ [ "Gratis (semua orang)", false ], [ "Premium (hanya subscriber)", true ] ], post.paid),
                          {},
                          class: "select select-bordered w-full",
                          data: { action: "change->posts#togglePaidFields" } %>
        </label>

        <div id="subscription-tier-field" class="fieldset" style="display: <%= post.paid? ? 'block' : 'none' %>;">
          <label class="fieldset-label">Paket Langganan
            <%= form.select :subscription_tier,
                            options_for_select([ [ "Basic (Rp 5.000/bln)", "basic" ], [ "Premium (Rp 15.000/bln)", "premium" ] ], post.subscription_tier),
                            {},
                            class: "select select-bordered w-full" %>
            <p class="text-xs opacity-60 mt-1">Menentukan tier minimum subscriber yang bisa akses. Basic subscriber akses Basic & Premium. Premium subscriber akses semua.</p>
          </label>
        </div>
      </fieldset>

      <div class="card-actions justify-end">
        <%= form.submit post.persisted? ? "Simpan Perubahan" : "Buat Post", class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>