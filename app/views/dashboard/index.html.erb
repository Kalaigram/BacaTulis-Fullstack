<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <span class="text-sm opacity-70">Total Post</span>
      <span class="text-3xl font-bold"><%= @post_count %></span>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <span class="text-sm opacity-70">Publikasi</span>
      <span class="text-3xl font-bold text-success"><%= @published_count %></span>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <span class="text-sm opacity-70">Draft</span>
      <span class="text-3xl font-bold text-warning"><%= @draft_count %></span>
    </div>
  </div>

  <% if current_user.admin? %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <span class="text-sm opacity-70">Total Pengguna</span>
        <span class="text-3xl font-bold"><%= @user_count %></span>
      </div>
    </div>
  <% end %>
</div>

<h2 class="text-lg font-bold mt-8 mb-3">Post Terbaru</h2>

<% if @recent_posts.any? %>
  <div class="grid gap-4">
    <% @recent_posts.each do |post| %>
      <article class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <div class="flex items-center justify-between gap-4">
            <h3 class="card-title">
              <%= link_to post.title, post, class: "link link-hover" %>
            </h3>
            <div class="flex items-center gap-2">
              <% if post.category %>
                <span class="badge badge-neutral badge-outline badge-sm"><%= post.category.name %></span>
              <% end %>
              <%= render "posts/status_badge", post: post %>
            </div>
          </div>
          <p class="text-sm opacity-70">oleh <%= post.user.email_address %> &middot; <%= time_ago_in_words(post.created_at) %> lalu</p>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <p>Belum ada post.</p>
    </div>
  </div>
<% end %>

<% if current_user.admin? && @recent_comments.any? %>
  <h2 class="text-lg font-bold mt-8 mb-3">Komentar Terbaru</h2>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body space-y-3">
      <% @recent_comments.each do |comment| %>
        <div class="border-base-300 border-t pt-2 first:border-t-0 first:pt-0">
          <p class="text-sm">
            <strong><%= comment.user.name.presence || comment.user.email_address %></strong> berkomentar di
            <%= link_to comment.post.title, comment.post, class: "link" %>
          </p>
          <p class="text-xs opacity-60"><%= time_ago_in_words(comment.created_at) %> lalu</p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>