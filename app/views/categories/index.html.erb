<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Kategori</h1>
  <%= link_to "Buat Kategori", new_category_path, class: "btn btn-primary" %>
</div>

<% if @categories.any? %>
  <div class="card bg-base-100 shadow-sm">
    <div class="overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>Nama</th>
            <th>Jumlah Post</th>
            <th>Slug</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td><span class="badge badge-neutral badge-outline"><%= category.name %></span></td>
              <td><%= category.posts.count %></td>
              <td><code><%= category.slug %></code></td>
              <td class="text-right">
                <%= link_to "Edit", edit_category_path(category), class: "btn btn-xs" %>
                <%= button_to "Hapus", category, method: :delete, class: "btn btn-xs btn-error", data: { turbo_confirm: "Hapus kategori #{category.name}? Post terkait menjadi tanpa kategori." } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <p>Belum ada kategori. Buat yang pertama untuk mengelompokkan post.</p>
    </div>
  </div>
<% end %>