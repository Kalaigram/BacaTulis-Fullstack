<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Moderasi Laporan</h1>
  <span class="badge badge-primary"><%= @reports.count %> pending</span>
</div>

<% if @reports.any? %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body space-y-4">
      <% @reports.each do |report| %>
        <div class="border-base-300 border-t pt-4 first:border-t-0 first:pt-0">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-2">
                <span class="badge badge-lg <%= report.status == 'pending' ? 'badge-warning' : 'badge-success' %>"><%= report.status %></span>
                <span class="badge badge-outline"><%= report.reason %></span>
              </div>
              <p class="text-sm">
                Dilaporkan oleh <strong><%= report.reporter.name.presence || report.reporter.email_address %></strong>
                <%= time_ago_in_words(report.created_at) %> lalu
              </p>
              <% if report.description.present? %>
                <p class="text-sm mt-1 opacity-80"><%= report.description %></p>
              <% end %>
              <div class="mt-2">
                <% if report.reportable.is_a?(Post) %>
                  <strong>Post:</strong> <%= link_to report.reportable.title, report.reportable, class: "link" %>
                <% elsif report.reportable.is_a?(Comment) %>
                  <strong>Komentar di:</strong> <%= link_to report.reportable.post.title, report.reportable.post, class: "link" %>
                  <div class="text-sm opacity-70 mt-1"><%= truncate(report.reportable.body, length: 100) %></div>
                <% end %>
              </div>
            </div>
            <div class="flex gap-2">
              <%= button_to admin_report_path(report, action_type: "resolve"), method: :patch, class: "btn btn-sm btn-success", data: { turbo_confirm: "Tandai laporan ini sebagai resolved?" } do %>
                Resolve
              <% end %>
              <%= button_to admin_report_path(report, action_type: "dismiss"), method: :patch, class: "btn btn-sm btn-ghost", data: { turbo_confirm: "Dismiss laporan ini?" } do %>
                Dismiss
              <% end %>
              <% if report.reportable.respond_to?(:user) && report.reportable.user != current_user %>
                <%= button_to admin_report_path(report, action_type: "ban_user"), method: :patch, class: "btn btn-sm btn-error", data: { turbo_confirm: "BAN USER #{report.reportable.user.email_address}? Tindakan ini tidak bisa dibatalkan!" } do %>
                  Ban User
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body text-center">
      <p>Tidak ada laporan pending. Semua bersih! 🎉</p>
    </div>
  </div>
<% end %>