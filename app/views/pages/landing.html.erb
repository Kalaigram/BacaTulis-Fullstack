<% content_for :title, "BacaTulis - Platform Blog Modern untuk Kreator" %>

<section class="hero min-h-screen bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">Tulis. Bagikan. <span class="text-primary">Monetisasi.</span></h1>
      <p class="py-6 text-base-content/70 text-lg">
        Platform blog modern untuk kreator Indonesia. Tulis konten premium, bangun komunitas subscriber, dan dapatkan pendapatan bulanan dari penulisan Anda.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <%= link_to "Mulai Gratis", new_registration_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Pelajari Lebih Lanjut", "#features", class: "btn btn-outline btn-lg" %>
      </div>
      <p class="mt-4 text-sm opacity-60">Tidak perlu kartu kredit · Setup 2 menit · Batalkan kapan saja</p>
    </div>
    <div class="relative">
      <div class="card bg-base-100 shadow-2xl w-full max-w-md mx-auto">
        <div class="card-body p-6">
          <div class="mock-browser mb-4">
            <div class="flex gap-1.5 mb-3">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="bg-base-200 rounded-lg p-4 font-mono text-sm space-y-2">
              <div class="flex items-center gap-2 text-primary">
                <span class="opacity-50">$</span>
                <span>bacatulis.new_post</span>
              </div>
              <div class="pl-8 space-y-1 opacity-70">
                <div>title: "Cara Membangun Audiens..."</div>
                <div>tier: "premium"</div>
                <div>status: "published"</div>
              </div>
              <div class="flex items-center gap-2 text-success mt-2">
                <span class="opacity-50">$</span>
                <span>✓ Published — 247 views, 12 subscribers</span>
              </div>
            </div>
          </div>
          <div class="stats grid grid-cols-3 gap-2 text-center">
            <div class="p-3 bg-primary/10 rounded-lg">
              <div class="text-2xl font-bold text-primary">247</div>
              <div class="text-xs opacity-60">Views hari ini</div>
            </div>
            <div class="p-3 bg-success/10 rounded-lg">
              <div class="text-2xl font-bold text-success">12</div>
              <div class="text-xs opacity-60">Subscriber baru</div>
            </div>
            <div class="p-3 bg-warning/10 rounded-lg">
              <div class="text-2xl font-bold text-warning">Rp 1.2jt</div>
              <div class="text-xs opacity-60">MRR bulan ini</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="features" class="py-20 bg-base-100">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-4">Semua Yang Butuh Kreator</h2>
      <p class="text-base-content/70 max-w-2xl mx-auto">Dibangun developer, untuk developer & kreator. Fokus pada pengalaman menulis terbaik.</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Feature 1 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1V4z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M3 18h18"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Editor Kaya (Rich Text)</h3>
          <p class="text-base-content/70 text-sm">Trix editor dengan formatting, gambar, embed, dan auto-save. Fokus menulis, bukan formatting.</p>
        </div>
      </div>

      <!-- Feature 2 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-success/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v-3m6 3h-12a2 2 0 01-2-2V7a2 2 0 012-2h12a2 2 0 012 2v6a2 2 0 01-2 2zm-6-9V4a1 1 0 011-1h4a1 1 0 011 1v2m-6 0h.01M12 12h.01M12 15h.01"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Konten Premium & Free</h3>
          <p class="text-base-content/70 text-sm">Set per-post: gratis untuk semua, atau kunci untuk subscriber Basic/Premium. Fleksibel per kebutuhan.</p>
        </div>
      </div>

      <!-- Feature 3 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-warning/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.172-.879-1.172-2.303 0-3.182z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Langganan Berjenjang</h3>
          <p class="text-base-content/70 text-sm">Basic Rp 5rb/bln, Premium Rp 15rb/bln. Stripe Checkout + Customer Portal. Otomatis handle pembayaran.</p>
        </div>
      </div>

      <!-- Feature 4 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-info/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Analytics Kreator</h3>
          <p class="text-base-content/70 text-sm">MRR, churn rate, subscriber growth, top paid posts. Chart.js visualisasi real-time di dashboard.</p>
        </div>
      </div>

      <!-- Feature 5 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-secondary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Komunitas & Interaksi</h3>
          <p class="text-base-content/70 text-sm">Like, bookmark, komentar threaded, notifikasi real-time. Bangun hubungan dengan pembaca.</p>
        </div>
      </div>

      <!-- Feature 6 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-error/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Moderasi & Keamanan</h3>
          <p class="text-base-content/70 text-sm">Laporan konten, antrian moderasi admin, ban user. Lingkungan aman untuk semua kreator.</p>
        </div>
      </div>

      <!-- Feature 7 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-base-300/50 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-base-content" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">Gambar & Hero Image</h3>
          <p class="text-base-content/70 text-sm">Upload hero image + gallery. Active Storage dengan variant otomatis (thumbnail, medium, large).</p>
        </div>
      </div>

      <!-- Feature 8 -->
      <div class="card bg-base-200 shadow-sm hover:shadow-lg transition-shadow">
        <div class="card-body">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-2">API & Webhooks</h3>
          <p class="text-base-content/70 text-sm">REST API v1 (JSON:API), token auth, rate limiting. Integrasi Zapier, Make, custom apps.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-20 bg-base-200">
  <div class="container mx-auto px-4">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body p-8 md:p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">Siap Memulai?</h2>
        <p class="text-base-content/70 mb-8 max-w-xl mx-auto">
          Bergabung dengan ratusan kreator Indonesia yang sudah monetisasi tulisan mereka. Gratis untuk memulai, upgrade kapan saja.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= link_to "Daftar Sekarang - Gratis", new_registration_path, class: "btn btn-primary btn-lg w-full sm:w-auto" %>
          <%= link_to "Lihat Demo Dashboard", root_path, class: "btn btn-outline btn-lg w-full sm:w-auto" %>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer bg-base-100 py-10">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="font-bold text-lg mb-4">BacaTulis</h3>
        <p class="text-sm opacity-70">Platform blog modern untuk kreator Indonesia. Tulis, bagikan, monetisasi.</p>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Produk</h4>
        <ul class="space-y-2 text-sm opacity-70">
          <li><%= link_to "Fitur", "#features" %></li>
          <li><%= link_to "Harga", "#pricing" %></li>
          <li><%= link_to "API Docs", "#api" %></li>
          <li><%= link_to "Changelog", "#changelog" %></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Kreator</h4>
        <ul class="space-y-2 text-sm opacity-70">
          <li><%= link_to "Dashboard", root_path %></li>
          <li><%= link_to "Analytics", "#" %></li>
          <li><%= link_to "Subscriber", "#" %></li>
          <li><%= link_to "Payout", "#" %></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-3">Dukungan</h4>
        <ul class="space-y-2 text-sm opacity-70">
          <li><%= link_to "Dokumentasi", "#" %></li>
          <li><%= link_to "Komunitas", "#" %></li>
          <li><%= link_to "Kontak", "#" %></li>
          <li><%= link_to "Status", "#" %></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-base-300 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm opacity-60">© 2025 BacaTulis. Dibangun dengan Rails 8 + Tailwind + daisyUI.</p>
      <div class="flex gap-6 text-sm opacity-60">
        <%= link_to "Privacy", "#" %>
        <%= link_to "Terms", "#" %>
        <%= link_to "Cookies", "#" %>
      </div>
    </div>
  </div>
</footer>

<style>
  .mock-browser {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    background: #f9fafb;
  }
</style>