<!DOCTYPE html>
<html class="light" lang="id">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>BacaTulis - Tulis. Bagikan. Monetisasi.</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary-fixed-variant": "#930000",
                        "on-background": "#191c1e",
                        "surface": "#f7f9fb",
                        "on-primary": "#ffffff",
                        "outline-variant": "#e8bcb6",
                        "inverse-primary": "#ffb4a8",
                        "surface-container-high": "#e6e8ea",
                        "on-tertiary-container": "#dbe9ff",
                        "surface-tint": "#c00001",
                        "on-error": "#ffffff",
                        "on-tertiary-fixed": "#0b1c30",
                        "surface-container": "#eceef0",
                        "secondary-fixed-dim": "#bec6e0",
                        "surface-container-highest": "#e0e3e5",
                        "surface-dim": "#d8dadc",
                        "error-container": "#ffdad6",
                        "primary": "#a50000",
                        "background": "#f7f9fb",
                        "secondary-fixed": "#dae2fd",
                        "secondary-container": "#dae2fd",
                        "on-secondary-container": "#5c647a",
                        "on-surface": "#191c1e",
                        "tertiary-fixed-dim": "#b7c8e1",
                        "on-surface-variant": "#5e3f3a",
                        "on-secondary-fixed": "#131b2e",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#596980",
                        "on-primary-container": "#ffe2dd",
                        "primary-fixed-dim": "#ffb4a8",
                        "on-secondary": "#ffffff",
                        "on-secondary-fixed-variant": "#3f465c",
                        "primary-fixed": "#ffdad4",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed-variant": "#38485d",
                        "inverse-on-surface": "#eff1f3",
                        "surface-container-low": "#f2f4f6",
                        "primary-container": "#d30001",
                        "error": "#ba1a1a",
                        "inverse-surface": "#2d3133",
                        "outline": "#936e69",
                        "surface-container-lowest": "#ffffff",
                        "secondary": "#565e74",
                        "surface-variant": "#e0e3e5",
                        "surface-bright": "#f7f9fb",
                        "tertiary": "#415167",
                        "on-primary-fixed": "#410000",
                        "tertiary-fixed": "#d3e4fe"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "card-padding": "24px",
                        "section-gap": "64px",
                        "gutter": "24px",
                        "container-max": "1280px",
                        "base": "4px"
                    },
                    "fontFamily": {
                        "headline-lg-mobile": ["Inter"],
                        "code-sm": ["JetBrains Mono"],
                        "headline-md": ["Inter"],
                        "label-caps": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["28px", { "lineHeight": "1.2", "fontWeight": "700" }],
                        "code-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "label-caps": ["12px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "700" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "800" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "1.75", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
  <style>
    .shadow-level-1 { box-shadow: 0px 4px 20px rgba(0,0,0,0.05); }
    .shadow-level-2 { box-shadow: 0px 10px 30px rgba(0,0,0,0.1); }
  </style>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<body class="bg-background text-on-surface font-body-md text-body-md min-h-screen flex flex-col antialiased">
  <!-- TopNavBar -->
  <nav class="full-width top-0 sticky bg-surface/80 dark:bg-on-background/80 backdrop-blur-md border-b border-outline-variant/30 flat no shadows z-50">
    <div class="flex justify-between items-center h-16 px-gutter max-w-container-max mx-auto">
      <div class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed hover:scale-95 transition-transform duration-200 cursor-pointer">
        BacaTulis
      </div>
      <div class="hidden md:flex gap-8">
        <a class="text-primary dark:text-primary-fixed font-semibold border-b-2 border-primary hover:text-primary dark:hover:text-primary-fixed transition-colors duration-200" href="#">Fitur</a>
        <a class="text-on-surface-variant dark:text-on-tertiary-container hover:text-primary dark:hover:text-primary-fixed transition-colors duration-200" href="#">Kreator</a>
        <a class="text-on-surface-variant dark:text-on-tertiary-container hover:text-primary dark:hover:text-primary-fixed transition-colors duration-200" href="#">Harga</a>
        <a class="text-on-surface-variant dark:text-on-tertiary-container hover:text-primary dark:hover:text-primary-fixed transition-colors duration-200" href="#">Bantuan</a>
      </div>
      <div class="flex items-center gap-4">
        <a class="text-on-surface-variant dark:text-on-tertiary-container hover:text-primary dark:hover:text-primary-fixed transition-colors duration-200 font-semibold" href="<%= new_session_path %>">Masuk</a>
        <%= link_to "Mulai Menulis", new_registration_path, class: "bg-primary-container text-on-primary border border-primary-container hover:bg-primary-container/90 transition-colors duration-200 px-4 py-2 rounded-lg font-semibold shadow-level-1 active:scale-98" %>
      </div>
    </div>
  </nav>

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="py-section-gap px-gutter max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-8">
        <h1 class="font-display-lg text-display-lg text-on-surface">Tulis. Bagikan. Monetisasi.</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg">
          Platform terbaik untuk kreator Indonesia. Fokus pada tulisan Anda, kami urus sisanya. Bangun audiens, tawarkan konten premium, dan kembangkan pendapatan Anda dengan ekosistem yang terintegrasi.
        </p>
        <div class="flex flex-wrap gap-4">
          <%= link_to "Mulai Gratis", new_registration_path, class: "bg-primary-container text-on-primary border border-primary-container hover:bg-primary-container/90 transition-all duration-200 px-6 py-3 rounded-lg font-semibold shadow-level-1 hover:shadow-level-2 hover:-translate-y-0.5 active:scale-98" %>
          <button class="bg-surface text-on-surface border border-outline hover:bg-surface-container-low transition-all duration-200 px-6 py-3 rounded-lg font-semibold active:scale-98">Pelajari Lebih Lanjut</button>
        </div>
        <div class="flex items-center gap-4 text-on-surface-variant">
          <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
          <span class="font-label-caps text-label-caps">TANPA KARTU KREDIT DIPERLUKAN</span>
        </div>
      </div>
      <div class="relative w-full h-[500px] bg-surface-container rounded-xl shadow-level-2 border border-outline/20 overflow-hidden flex flex-col">
        <div class="bg-surface-container-highest px-4 py-3 border-b border-outline/10 flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-error"></div>
          <div class="w-3 h-3 rounded-full bg-secondary-fixed-dim"></div>
          <div class="w-3 h-3 rounded-full bg-surface-dim"></div>
        </div>
        <div class="flex-1 p-6 grid grid-cols-2 gap-4">
          <div class="bg-surface rounded-lg p-4 shadow-level-1 border border-outline/10">
            <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2">Total Views</h3>
            <p class="font-headline-md text-headline-md text-on-surface">124.5K</p>
            <p class="text-sm text-primary-container mt-2 flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px]" data-icon="trending_up">trending_up</span> +12%
            </p>
          </div>
          <div class="bg-surface rounded-lg p-4 shadow-level-1 border border-outline/10">
            <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2">Subscribers</h3>
            <p class="font-headline-md text-headline-md text-on-surface">4,209</p>
            <p class="text-sm text-primary-container mt-2 flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px]" data-icon="trending_up">trending_up</span> +5%
            </p>
          </div>
          <div class="bg-surface rounded-lg p-4 shadow-level-1 border border-outline/10 col-span-2">
            <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-2">Monthly Recurring Revenue (MRR)</h3>
            <p class="font-headline-lg text-headline-lg text-on-surface text-primary-container">Rp 21.500.000</p>
            <div class="w-full h-24 mt-4 bg-surface-container-low rounded relative overflow-hidden">
              <svg class="absolute inset-0 w-full h-full text-primary-container/20" preserveAspectRatio="none" viewBox="0 0 100 100">
                <path d="M0 100 L0 50 Q 25 40 50 60 T 100 20 L 100 100 Z" fill="currentColor"></path>
                <path d="M0 50 Q 25 40 50 60 T 100 20" fill="none" stroke="#d30001" stroke-width="2"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-section-gap px-gutter max-w-container-max mx-auto bg-surface-container-lowest rounded-xl shadow-level-1 border border-outline/10 my-section-gap">
      <div class="text-center mb-12">
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">Fitur Lengkap untuk Kreator</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Semua alat yang Anda butuhkan untuk menulis, menerbitkan, dan membangun bisnis konten Anda dalam satu platform yang elegan.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="edit_document">edit_document</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Rich Text Editor</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Editor fokus (Trix) yang sederhana dan intuitif. Tanpa gangguan, hanya Anda dan kata-kata Anda.</p>
        </div>
        <!-- Card 2 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="lock">lock</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Premium & Free</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Atur konten mana yang gratis untuk publik dan mana yang eksklusif (gated) untuk pelanggan berbayar.</p>
        </div>
        <!-- Card 3 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="payments">payments</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Tiered Subs</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Dukung tier langganan Rp5rb & Rp15rb terintegrasi mulus dengan Stripe untuk pembayaran lokal & global.</p>
        </div>
        <!-- Card 4 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="analytics">analytics</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Creator Analytics</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Pantau metrik penting seperti MRR, churn rate, dan pertumbuhan pelanggan dengan visualisasi yang jelas.</p>
        </div>
        <!-- Card 5 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="forum">forum</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Community</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Bangun komunitas yang aktif dengan fitur komentar bersarang dan interaksi sosial yang terdesain rapi.</p>
        </div>
        <!-- Card 6 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="shield">shield</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Moderation</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Alat admin yang kuat untuk menjaga komunitas Anda tetap aman dan teratur dari spam.</p>
        </div>
        <!-- Card 7 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="image">image</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">Image Hosting</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Didukung oleh Active Storage untuk pengelolaan media yang cepat, andal, dan teroptimasi.</p>
        </div>
        <!-- Card 8 -->
        <div class="bg-surface p-card-padding rounded-xl shadow-level-1 hover:shadow-level-2 hover:-translate-y-1 transition-all duration-300 border border-outline/10 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-primary-container/10 flex items-center justify-center text-primary-container">
            <span class="material-symbols-outlined" data-icon="api">api</span>
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface text-[20px]">API & Webhooks</h3>
          <p class="font-body-md text-body-md text-on-surface-variant">Fitur berorientasi developer untuk mengintegrasikan alur kerja Anda dengan alat eksternal lainnya.</p>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-section-gap px-gutter text-center bg-primary-container/5 my-section-gap">
      <div class="max-w-2xl mx-auto flex flex-col gap-6 items-center">
        <h2 class="font-display-lg text-display-lg text-on-surface">Siap Memulai?</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant">Bergabunglah dengan ribuan kreator Indonesia yang telah membangun audiens dan pendapatan mereka di BacaTulis.</p>
        <%= link_to "Buat Publikasi Sekarang", new_registration_path, class: "bg-primary-container text-on-primary border border-primary-container hover:bg-primary-container/90 transition-all duration-200 px-8 py-4 rounded-lg font-semibold shadow-level-1 hover:shadow-level-2 hover:-translate-y-0.5 active:scale-98 mt-4 text-lg" %>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="full-width bottom-0 bg-surface-container-lowest dark:bg-on-background border-t border-outline-variant/20 flat no shadows mt-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-section-gap py-16 px-gutter max-w-container-max mx-auto">
      <div class="col-span-1 md:col-span-1 flex flex-col gap-4">
        <div class="font-headline-md text-headline-md font-bold text-primary">
          BacaTulis
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant mt-2">
          © 2024 BacaTulis. Dibuat untuk ekosistem penulis Indonesia.
        </p>
      </div>
      <div class="col-span-1 md:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col gap-3">
          <h4 class="font-label-caps text-label-caps text-on-surface font-semibold mb-2">PRODUK</h4>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Fitur</a>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Harga</a>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">API Dokumentasi</a>
        </div>
        <div class="flex flex-col gap-3">
          <h4 class="font-label-caps text-label-caps text-on-surface font-semibold mb-2">PERUSAHAAN</h4>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Tentang Kami</a>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Panduan Komunitas</a>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Hubungi Kami</a>
        </div>
        <div class="flex flex-col gap-3">
          <h4 class="font-label-caps text-label-caps text-on-surface font-semibold mb-2">LEGAL</h4>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Kebijakan Privasi</a>
          <a class="font-body-md text-body-md text-on-surface-variant dark:text-on-tertiary-container hover:text-primary hover:underline transition-all hover:translate-x-1 duration-200" href="#">Syarat & Ketentuan</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>