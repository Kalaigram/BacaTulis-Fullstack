<div class="flex items-center justify-between gap-4 mb-6">
  <h1 class="text-2xl font-bold">Tag</h1>
  <%= link_to "Tambah Tag", "#", class: "btn btn-primary", data: { action: "click->tags#showForm" } %>
</div>

<%= form_with url: tags_path, method: :post, class: "card bg-base-100 shadow-sm mb-4", data: { controller: "tags", target: "tags.form" } do |form| %>
  <div class="card-body flex-row flex-wrap items-end gap-2 p-4">
    <%= form.label :name, "Nama Tag", class: "label-text" %>
    <%= form.text_field :name, placeholder: "Contoh: rails, tutorial, tips", class: "input input-sm" %>
    <%= form.submit "Simpan", class: "btn btn-sm btn-primary" %>
  </div>
<% end %>

<% if @tags.any? %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <div class="flex flex-wrap gap-2">
        <% @tags.each do |tag| %>
          <div class="badge badge-outline badge-lg gap-1">
            <%= tag.name %>
            <% if current_user.admin? %>
              <%= button_to tag_path(tag), method: :delete, class: "btn btn-xs btn-ghost btn-error", data: { turbo_confirm: "Yakin ingin menghapus tag #{tag.name}?" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7 3H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V5a1 1 0 100-2h-3l-.106-.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <p>Belum ada tag. Buat yang pertama!</p>
    </div>
  </div>
<% end %>